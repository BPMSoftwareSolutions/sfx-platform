# Canonical origin. The apex redirects here.
NEXT_PUBLIC_SITE_ORIGIN=https://www.sidefx.io

# Estate publication source: one pinned generation of the selected model.
SIDEFX_ESTATE_SOURCE=C:/lab/sidefx-database/data/website-visuals/inventory-2026-09-08.json

# Age in days after which the site shows its stale-publication notice.
SIDEFX_MAX_PUBLICATION_AGE_DAYS=30

# Runtime staging setting. Keep it sticky to the Azure staging slot.
# SIDEFX_INDEXING=disabled

# Reserved for the future durable inquiry/delivery adapter. Hosted submissions currently fail
# with input preserved; these values alone do not enable a store or mail worker.
SIDEFX_INQUIRY_RECIPIENT=
SIDEFX_MAIL_API_KEY=

# Capability command service running beside the web process (services/capability-api).
# Without it a Run request reports execution unavailable without dispatch.
SIDEFX_INVOCATION_ENDPOINT=http://127.0.0.1:8787
# Response deadline, longer than the service's 600000 ms command deadline.
SIDEFX_INVOCATION_TIMEOUT_MS=630000
# Build-time directory of example requests, matched to capabilities by their declared contractId.
SIDEFX_CAPABILITY_EXAMPLES=
