{
  "html": "\n<div class=\"ui-surface\" data-surface-profile=\"window\" style=\"width:560px;height:306px;\">\n  <div class=\"ui-container\" style=\"left:0px;top:0px;width:560px;height:306px;\" data-region-id=\"dialog\" data-region-path=\"dialog\" data-role=\"capability-input-dialog\" data-tenant-policy=\"single\">\n    <div class=\"ui-container\" style=\"left:0px;top:0px;width:560px;height:84px;\" data-region-id=\"dialog-header\" data-region-path=\"dialog/dialog-header\" data-role=\"dialog-title\" data-tenant-policy=\"single\">\n      <div class=\"ui-container\" style=\"left:20px;top:16px;width:520px;height:18px;\" data-region-id=\"dialog-eyebrow\" data-region-path=\"dialog/dialog-header/dialog-eyebrow\" data-tenant-policy=\"single\">\n        <div class=\"ui-component\" style=\"left:0px;top:0px;width:520px;height:18px;\" data-component-id=\"dialog-context\"><span data-component-type=\"label\" data-semantic-family=\"information\" data-semantic-identity=\"resolve-sidefx-eligible-providers#context\" data-presentation-intent=\"section-label\" data-realized-via=\"type\" style=\"font:10px/1.5 ui-monospace,monospace;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);\">RESOLVE-SIDEFX-ELIGIBLE-PROVIDERS</span></div>\n      </div>\n      <div class=\"ui-container\" style=\"left:20px;top:40px;width:520px;height:28px;\" data-region-id=\"dialog-heading\" data-region-path=\"dialog/dialog-header/dialog-heading\" data-tenant-policy=\"single\">\n        <div class=\"ui-component\" style=\"left:0px;top:0px;width:520px;height:28px;\" data-component-id=\"dialog-title\"><h2 data-component-type=\"heading\" data-semantic-family=\"information\" data-semantic-identity=\"resolve-sidefx-eligible-providers#title\" data-presentation-intent=\"card-title\" data-realized-via=\"type\" style=\"font-size:20px;line-height:1.35;font-weight:500;color:var(--inspect-ink);\">Enter Capability Input</h2></div>\n      </div>\n    </div>\n    <div class=\"ui-container\" style=\"left:0px;top:84px;