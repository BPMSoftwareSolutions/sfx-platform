{
  "html": "\n<div class=\"ui-surface\" data-surface-profile=\"window\" style=\"width:560px;height:1164px;\">\n  <div class=\"ui-container\" style=\"left:0px;top:0px;width:560px;height:1164px;\" data-region-id=\"outcome-dialog\" data-region-path=\"outcome-dialog\" data-role=\"capability-outcome-dialog\" data-tenant-policy=\"single\">\n    <div class=\"ui-container\" style=\"left:0px;top:0px;width:560px;height:84px;\" data-region-id=\"outcome-header\" data-region-path=\"outcome-dialog/outcome-header\" data-role=\"dialog-title\" data-tenant-policy=\"single\">\n      <div class=\"ui-container\" style=\"left:20px;top:16px;width:520px;height:18px;\" data-region-id=\"outcome-eyebrow\" data-region-path=\"outcome-dialog/outcome-header/outcome-eyebrow\" data-tenant-policy=\"single\">\n        <div class=\"ui-component\" style=\"left:0px;top:0px;width:520px;height:18px;\" data-component-id=\"outcome-context\"><span data-component-type=\"label\" data-semantic-family=\"information\" data-semantic-identity=\"resolve-sidefx-eligible-providers#not-observable.context\" data-presentation-intent=\"section-label\" data-realized-via=\"type\" style=\"font:10px/1.5 ui-monospace,monospace;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);\">SIDEFX-SEMANTIC-PROVIDER-RESOLUTION.V1</span></div>\n      </div>\n      <div class=\"ui-container\" style=\"left:20px;top:40px;width:520px;height:28px;\" data-region-id=\"outcome-heading\" data-region-path=\"outcome-dialog/outcome-header/outcome-heading\" data-tenant-policy=\"single\">\n        <div class=\"ui-component\" style=\"left:0px;top:0px;width:520px;height:28px;\" data-component-id=\"outcome-title\"><h2 data-component-type=\"heading\" data-semantic-family=\"information\" data-semantic-identity=\"resolve-sidefx-eligible-providers#not-observable.title\" data-presentation-intent=\"card-title\" data-realized-via=\"type\" style=\"font-size:20px;line-height:1.35;font-weight:500;color:var(--inspect-ink);\">Capability outcome</h2></div>\