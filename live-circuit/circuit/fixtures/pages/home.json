      "props": {
        "items": [
          { "title": "Zero Implicit Authority", "body": "Intelligence may propose. Authority is explicit, evaluated, and resolved downstream before any effect.", "promise": "No effect without an admitted authority path." },
          { "title": "Sovereignty at Scale", "body": "Declared meaning stays in your authority database; execution follows your admitted providers and policies.", "promise": "Your estate, your rules." },
          { "title": "Semantic Flight Recording", "body": "Execution is captured as ordered testimony, so a run can be replayed from its receipts rather than reconstructed from logs.", "promise": "The record is the run's own account." },
          { "title": "Evidence by Design", "body": "Effects arrive with their retained receipts and stated limits; a page view or a declaration alone is never presented as proof.", "promise": "Reads are not receipts." },
          { "title": "Independent Evaluation", "body": "Evaluation is separate from operation, so a verdict does not depend on the operator's own account.", "promise": "The judge is not the party." },
          { "title": "Enterprise / Government", "body": "Designed for governed environments where authority, retention, and review are requirements rather than afterthoughts.", "promise": "Built for governed environments." }
