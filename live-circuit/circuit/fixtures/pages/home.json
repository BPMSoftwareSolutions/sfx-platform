    {
      "sectionId": "home-how-text",
      "regionId": "main",
      "order": 11,
      "component": {
        "kind": "text",
        "version": 1,
        "contractDigest": "5d634b8cf213421bc4786f56e975fd54c269d7bd8ade56c026f2e60bb8743a83"
      },
      "props": {
        "role": "paragraph",
        "text": "Intelligence proposes. Capability authority admits. A declared provider executes. Nothing receives authority merely because intelligence proposed it, and capabilities survive provider change. Execution naturally produces the evidence required for evaluation."
      }
    },
    {
      "sectionId": "home-how-basis",
      "regionId": "main",
      "order": 12,
      "component": {
        "kind": "text",
        "version": 1,
        "contractDigest": "5d634b8cf213421bc4786f56e975fd54c269d7bd8ade56c026f2e60bb8743a83"
      },
      "props": {
        "role": "note",
        "text": "Architecture and research items on this page are labelled Lab or Preview. This page makes no compliance, coverage or availability claim."
      }
    },
    {
      "sectionId": "home-how-cards",
      "regionId": "main",
      "order": 13,
      "component": {
        "kind": "card-list",
        "version": 1,
        "contractDigest": "efa04ceaa25dc0e4406a578caf7175d7833e3085af8ef80b4ec632bbdf3410d3"
      },
      "props": {
        "title": "The propositions this page carries",
        "cards": [
          {
            "cardId": "proposition-zero-implicit-authority",
            "title": "Zero Implicit Authority",
            "body": "Nothing receives authority merely because intelligence proposed it.",
            "promise": "Authority is evaluated before effect.",
            "meta": "Settled proposition"
          },
          {
            "cardId": "proposition-sovereignty-at-scale",
            "title": "Sovereignty at Scale",
            "body": "Your capability remains yours even when the intelligence, cloud, API, model, runtime or physical provider changes.",
            "promise": "Providers change. Capability identity survives.",
            "meta": "Settled proposition"
          },
          {
            "cardId": "proposition-semantic-flight-recording",
            "title": "Semantic Flight Recording",
            "body": "Do not reconstruct consequential AI behavior after the fact. Preserve the causal neighborhood around the moment it happened.",
            "promise": "Architecture and research; Lab or Preview until the flight-recording gates close.",
            "meta": "Architecture / research - Lab / Preview"
          },
          {
            "cardId": "proposition-evidence-by-design",
            "title": "Evidence by Design",
            "body": "Execution naturally produces the evidence required for evaluation.",
            "promise": "Evaluate the execution, not merely the model.",
            "meta": "Settled proposition"
          },
          {
            "cardId": "proposition-independent-evaluation",
            "title": "Independent Evaluation",
            "body": "Evaluate the system that gives intelligence agency, not only the model.",
            "promise": "Expected circuit and recorded circuit: satisfied, violated, not observable, inconclusive.",
            "meta": "Settled proposition"
          },
          {
            "cardId": "proposition-enterprise-government",
            "title": "Enterprise / Government",
            "body": "Give AI useful agency without giving it implicit authority.",
            "promise": "Mission, Authority, Capability, Effect, Evidence.",
            "meta": "Settled proposition"
          }
        ]
      }
    }
